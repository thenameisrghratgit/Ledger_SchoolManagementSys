# Supabase project credentials (Project Settings -> API)
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Preferred: new publishable key (sb_publishable_...). Legacy anon key also works.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Fallback (only if you don't use the publishable key):
# VITE_SUPABASE_ANON_KEY=
